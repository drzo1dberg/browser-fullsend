{
  "manifest_version": 3,
  "name": "browser-fullsend",
  "version": "0.2.0",
  "description": "Video fullscreen that stays inside the browser window. The OS window keeps its size and place.",
  "homepage_url": "https://github.com/drzo1dberg/browser-fullsend",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "css": ["style.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    }
  ]
}
