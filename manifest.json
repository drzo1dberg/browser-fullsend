{
  "manifest_version": 3,
  "name": "browser-fullsend",
  "version": "0.1.0",
  "description": "Keeps video fullscreen inside the browser window instead of taking over the whole screen.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "css": ["style.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    }
  ]
}
